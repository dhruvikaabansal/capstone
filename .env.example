# Copy to .env and fill in. Never commit the real .env.

# --- Portal ---------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Long random string. Required in production; the app refuses to start without
# it when NODE_ENV=production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# --- Database -------------------------------------------------------------
# Local install:
MONGODB_URI=mongodb://localhost:27017/smart-policing-portal
# Docker Compose uses mongodb://mongo:27017/smart-policing-portal instead.

# --- Prediction service ---------------------------------------------------
MODEL_API_URL=http://localhost:8000
MODEL_TIMEOUT_MS=15000

# --- Google OAuth (optional) ---------------------------------------------
# Leave blank to hide Google sign-in. Redirect URI must be registered as
# http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/auth/google/callback
