<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Smart Policing Portal</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>
:root {
  --navy: #0b2545;
  --navy-light: #14395f;
  --accent: #2f6fed;
  --bg: #f4f6f9;
  --surface: #fff;
  --border: #dee2e6;
  --text: #212529;
  --muted: #6c757d;
  --danger: #c0392b;
  --warning: #d97706;
  --success: #1a7f4b;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  background: var(--bg); color: var(--text);
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  line-height: 1.5; padding-bottom: 40px;
}

/* Header */
.header { background: var(--navy); color: #fff; padding: 18px 32px 0; box-shadow: 0 2px 4px rgba(0,0,0,.1); }
.title-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; margin-bottom: 16px; }
.title-main h1 { font-size: 20px; font-weight: 800; letter-spacing: 1px; }
.title-main h2 { font-size: 13px; color: #a9c6f5; font-weight: 400; margin-top: 2px; }
.status-badge { display: flex; align-items: center; gap: 14px; font-size: 13px; flex-wrap: wrap; }
.status-badge .records { color: #a9c6f5; }
.badge { display: inline-flex; align-items: center; gap: 7px; background: #2b5f45; color: #d6f5e3; padding: 4px 11px; border-radius: 4px; font-weight: 700; font-size: 11px; letter-spacing: .5px; }
.badge::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: #4ade80; }
.badge.offline { background: #5c2320; color: #ffd9d5; }
.badge.offline::before { background: #f87171; }
.logout-form { display: inline; }
.logout-btn { background: transparent; border: 1px solid rgba(255,255,255,.4); color: #fff; padding: 5px 12px; border-radius: 4px; font-size: 12px; cursor: pointer; font-family: inherit; }
.logout-btn:hover { background: rgba(255,255,255,.12); }

.tabs { display: flex; gap: 6px; overflow-x: auto; }
.tab { padding: 11px 15px; color: #a9c6f5; font-size: 13px; font-weight: 600; cursor: pointer; border: none; background: none; border-bottom: 3px solid transparent; white-space: nowrap; font-family: inherit; letter-spacing: .3px; }
.tab:hover { color: #fff; }
.tab.active { color: #fff; border-bottom-color: #fff; background: rgba(255,255,255,.08); border-radius: 4px 4px 0 0; }

/* Layout */
.container { padding: 26px 32px; max-width: 1400px; margin: 0 auto; }
.tab-content { display: none; }
.tab-content.active-content { display: block; animation: fade .25s ease; }
@keyframes fade { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }

.grid { display: grid; grid-template-columns: 340px 1fr; gap: 22px; align-items: start; }
.stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

.card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 18px; box-shadow: 0 1px 3px rgba(0,0,0,.04); }
.card h3 { font-size: 11px; color: var(--muted); font-weight: 700; letter-spacing: .7px; text-transform: uppercase; margin-bottom: 7px; }
.card .value { font-size: 26px; font-weight: 700; line-height: 1.15; }
.card .value.small { font-size: 19px; }
.card .label { font-size: 12.5px; color: var(--muted); margin-top: 3px; }
.span-2 { grid-column: span 2; }

.section-header { border-bottom: 1px solid #e9ecef; padding-bottom: 10px; margin-bottom: 16px; }
.section-header h3 { font-size: 15px; font-weight: 700; }
.section-header p { font-size: 12.5px; color: var(--muted); margin-top: 2px; }

.panel { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 20px; box-shadow: 0 1px 3px rgba(0,0,0,.04); }
.panel + .panel { margin-top: 22px; }

.chart-box { position: relative; height: 300px; }
.charts-row { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }

.provenance { font-size: 12px; color: var(--muted); background: #f8f9fa; border-left: 3px solid var(--accent); padding: 10px 12px; border-radius: 0 4px 4px 0; margin-top: 14px; }

.notice { padding: 13px 16px; border-radius: 6px; border-left: 4px solid var(--navy); background: #eaeef4; font-size: 14px; margin-bottom: 20px; }
.notice.warn { border-color: var(--warning); background: #fdf4e3; }
.notice.error { border-color: var(--danger); background: #fdecea; color: #7d241a; }

/* Forms */
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.form-group { margin-bottom: 14px; }
.form-group label { display: block; font-size: 11.5px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; color: var(--muted); margin-bottom: 5px; }
.form-group input, .form-group select { width: 100%; padding: 9px 11px; border: 1px solid #ced4da; border-radius: 5px; font-size: 14px; font-family: inherit; }
.form-group input:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
.form-group .hint { font-size: 11.5px; color: var(--muted); margin-top: 4px; }
.btn { padding: 11px 20px; border: none; border-radius: 6px; background: var(--accent); color: #fff; font-weight: 700; font-size: 13.5px; cursor: pointer; font-family: inherit; width: 100%; }
.btn:hover:not(:disabled) { background: #2559c4; }
.btn:disabled { opacity: .6; cursor: progress; }
.btn-ghost { background: #fff; color: var(--navy); border: 1px solid var(--border); }

details.advanced { margin: 4px 0 16px; }
details.advanced summary { cursor: pointer; font-size: 13px; color: var(--accent); font-weight: 600; padding: 6px 0; }

/* Results */
.result { margin-top: 20px; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; display: none; }
.result-head { padding: 14px 16px; color: #fff; }
.result-head .rl { font-size: 12px; letter-spacing: 1px; opacity: .85; }
.result-head .rv { font-size: 22px; font-weight: 800; }
.result-body { padding: 16px; background: #fff; }
.metric-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #f1f3f5; font-size: 14px; }
.metric-row:last-child { border-bottom: none; }
.metric-row .k { color: var(--muted); }
.metric-row .v { font-weight: 700; }

.tag { display: inline-block; font-size: 10.5px; font-weight: 700; letter-spacing: .4px; padding: 2px 7px; border-radius: 3px; text-transform: uppercase; }
.tag-observed { background: #e3f0e8; color: #14603a; }
.tag-derived { background: #e6edfb; color: #1c3f8f; }
.tag-default { background: #f1f3f5; color: #495057; }
.tag-override { background: #fdf0dd; color: #8a5200; }

table.prov { width: 100%; border-collapse: collapse; font-size: 12.5px; margin-top: 8px; }
table.prov th { text-align: left; color: var(--muted); font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: .4px; padding: 6px 8px; border-bottom: 1px solid var(--border); }
table.prov td { padding: 6px 8px; border-bottom: 1px solid #f1f3f5; }
table.prov td.num { text-align: right; font-variant-numeric: tabular-nums; }

/* Maps */
.map-frame { height: 68vh; min-height: 420px; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; background: #fff; }
.map-frame iframe { width: 100%; height: 100%; border: 0; }
#routingMap { width: 100%; height: 430px; border-radius: 6px; }

.route-list { max-height: 380px; overflow-y: auto; margin-top: 14px; border-top: 1px solid var(--border); }
.route-stop { display: flex; gap: 12px; align-items: center; padding: 11px 4px; border-bottom: 1px solid #f1f3f5; }
.route-stop .n { flex: 0 0 27px; height: 27px; border-radius: 50%; background: var(--navy); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; }
.route-stop.start .n { background: var(--success); }
.route-stop .meta { flex: 1; min-width: 0; }
.route-stop .sid { font-weight: 700; font-size: 13px; }
.route-stop .sub { font-size: 12px; color: var(--muted); }
.route-stop .km { font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }

.muted-empty { color: var(--muted); font-style: italic; font-size: 13px; padding: 14px 0; }
.skeleton { color: var(--muted); font-size: 13px; }

@media (max-width: 1050px) {
  .grid, .charts-row, .form-row { grid-template-columns: 1fr; }
  .container { padding: 20px; }
  .header { padding: 16px 20px 0; }
}
@media (max-width: 620px) {
  .stats-grid { grid-template-columns: 1fr; }
  .span-2 { grid-column: span 1; }
}
</style>
</head>
<body>

<header class="header">
  <div class="title-row">
    <div class="title-main">
      <h1>SMART POLICING PORTAL</h1>
      <h2>Sector risk assessment and patrol planning</h2>
    </div>
    <div class="status-badge">
      <span class="records" id="record-count">Loading dataset…</span>
      <span class="badge" id="engine-badge">CHECKING ENGINE</span>
      <span>Signed in: <strong><%= user.name %></strong></span>
      <form class="logout-form" action="/logout" method="POST">
        <button class="logout-btn" type="submit">Sign out</button>
      </form>
    </div>
  </div>
  <nav class="tabs">
    <button class="tab active" data-target="tab-overview">Overview</button>
    <button class="tab" data-target="tab-map">Incident Map</button>
    <button class="tab" data-target="tab-routing">Patrol Optimiser</button>
    <button class="tab" data-target="tab-assessor">Risk Assessor</button>
    <button class="tab" data-target="tab-model">Model Card</button>
  </nav>
</header>

<div class="container">

  <!-- ============================ OVERVIEW ============================ -->
  <section id="tab-overview" class="tab-content active-content">
    <div class="notice" id="briefing">Loading the current sector assessment…</div>

    <div class="grid">
      <div class="stats-grid">
        <div class="card span-2" style="border-left: 4px solid var(--accent);">
          <h3>Incidents in dataset</h3>
          <div class="value" id="stat-incidents">—</div>
          <div class="label" id="stat-incidents-label">Records the models were built on</div>
        </div>

        <div class="card span-2" style="border-left: 4px solid var(--danger);">
          <h3>Sectors flagged as hotspots</h3>
          <div class="value" id="stat-hotspots">—</div>
          <div class="label" id="stat-hotspots-label">Scored at or above 0.50 probability</div>
        </div>

        <div class="card" style="border-left: 4px solid var(--warning);">
          <h3>High risk</h3>
          <div class="value small" id="stat-high">—</div>
          <div class="label">Probability ≥ 0.75</div>
        </div>

        <div class="card" style="border-left: 4px solid var(--success);">
          <h3>Sectors mapped</h3>
          <div class="value small" id="stat-sectors">—</div>
          <div class="label" id="stat-grid-label">City grid cells</div>
        </div>

        <div class="card span-2" style="border-left: 4px solid var(--navy);">
          <h3>Busiest single sector</h3>
          <div class="value small" id="stat-busiest">—</div>
          <div class="label">Highest recorded incident count in one sector</div>
        </div>
      </div>

      <div class="panel">
        <div class="section-header">
          <h3>Modelled risk across the city</h3>
          <p>Every mapped sector scored by the hotspot classifier.</p>
        </div>
        <div class="chart-box"><canvas id="riskChart"></canvas></div>
        <div class="provenance" id="agreement-note">Loading model agreement…</div>
      </div>
    </div>

    <div class="panel">
      <div class="section-header">
        <h3>Highest-risk sectors right now</h3>
        <p>Ranked by classifier probability, with the incident count actually recorded in each.</p>
      </div>
      <div class="chart-box" style="height: 320px;"><canvas id="topSectorsChart"></canvas></div>
    </div>
  </section>

  <!-- ============================ MAP ============================ -->
  <section id="tab-map" class="tab-content">
    <div class="notice">
      <strong>Incident density.</strong> Warmer colours mark sectors with more recorded incidents
      across the full history in the dataset. This is the observed record, not a forecast — use the
      Risk Assessor for modelled output.
    </div>
    <div class="map-frame">
      <iframe src="/density-map" title="Incident density map" loading="lazy"></iframe>
    </div>
  </section>

  <!-- ============================ ROUTING ============================ -->
  <section id="tab-routing" class="tab-content">
    <div class="grid">
      <div class="panel">
        <div class="section-header">
          <h3>Patrol route optimiser</h3>
          <p>Shortest sequence through the highest-risk sectors.</p>
        </div>
        <p style="font-size: 13px; color: var(--muted); margin-bottom: 14px;">
          Stops are the sectors the classifier currently ranks highest. The order is solved as a
          travelling-salesman problem with Google OR-Tools over great-circle distances.
        </p>

        <div class="form-group">
          <label for="stop-count">Number of stops</label>
          <input id="stop-count" type="number" min="3" max="20" value="8" />
        </div>
        <div class="form-group">
          <label for="round-trip">Return to start</label>
          <select id="round-trip">
            <option value="true" selected>Yes — closed patrol loop</option>
            <option value="false">No — open path</option>
          </select>
        </div>

        <button id="optimize-btn" class="btn">Generate route</button>

        <div id="route-summary" class="provenance" style="display:none;"></div>
        <div id="route-list" class="route-list">
          <div class="muted-empty">No route generated yet.</div>
        </div>
      </div>

      <div class="panel">
        <div class="section-header">
          <h3>Route map</h3>
          <p>Green marks the first stop.</p>
        </div>
        <div id="routingMap"></div>
      </div>
    </div>
  </section>

  <!-- ============================ ASSESSOR ============================ -->
  <section id="tab-assessor" class="tab-content">
    <div class="grid">
      <div class="panel">
        <div class="section-header">
          <h3>Sector risk assessor</h3>
          <p>Score any point in the city.</p>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="lat-input">Latitude</label>
            <input id="lat-input" type="number" step="0.001" value="41.885" />
          </div>
          <div class="form-group">
            <label for="lon-input">Longitude</label>
            <input id="lon-input" type="number" step="0.001" value="-87.630" />
          </div>
        </div>

        <details class="advanced">
          <summary>Override sector activity profile</summary>
          <p style="font-size: 12.5px; color: var(--muted); margin: 8px 0 12px;">
            The models are driven mainly by a sector's activity history, not its coordinates. Values
            left blank fall back to what is on record for the sector, or to a city-wide median where
            nothing is recorded.
          </p>
          <div class="form-row">
            <div class="form-group">
              <label for="peak-input">Peak-hour incidents</label>
              <input id="peak-input" type="number" min="0" step="1" placeholder="from record" />
              <p class="hint">Strongest single driver (34% of classifier weight).</p>
            </div>
            <div class="form-group">
              <label for="unique-input">Distinct offence types</label>
              <input id="unique-input" type="number" min="0" step="0.5" placeholder="23.5" />
            </div>
            <div class="form-group">
              <label for="lastyear-input">Incidents last year</label>
              <input id="lastyear-input" type="number" min="0" step="1" placeholder="10.5" />
            </div>
            <div class="form-group">
              <label for="twoyear-input">Incidents two years ago</label>
              <input id="twoyear-input" type="number" min="0" step="1" placeholder="18.5" />
            </div>
            <div class="form-group">
              <label for="arrest-input">Arrest rate</label>
              <input id="arrest-input" type="number" min="0" max="1" step="0.01" placeholder="0.26" />
            </div>
            <div class="form-group">
              <label for="domestic-input">Domestic rate</label>
              <input id="domestic-input" type="number" min="0" max="1" step="0.01" placeholder="0.13" />
            </div>
          </div>
        </details>

        <button id="predict-btn" class="btn">Assess sector</button>

        <div id="predict-result" class="result">
          <div class="result-head" id="result-head">
            <div class="rl">CLASSIFICATION</div>
            <div class="rv" id="result-verdict"></div>
          </div>
          <div class="result-body">
            <div class="metric-row"><span class="k">Sector</span><span class="v" id="r-sector"></span></div>
            <div class="metric-row"><span class="k">Hotspot probability</span><span class="v" id="r-prob"></span></div>
            <div class="metric-row"><span class="k">Predicted incidents</span><span class="v" id="r-pred"></span></div>
            <div class="metric-row"><span class="k">Recorded in this sector</span><span class="v" id="r-obs"></span></div>
            <div class="metric-row"><span class="k">Confidence</span><span class="v" id="r-conf"></span></div>
            <div id="r-notes"></div>
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="section-header">
          <h3>What went into this assessment</h3>
          <p>Every feature the models received, and where each value came from.</p>
        </div>
        <div id="prov-table"><div class="muted-empty">Run an assessment to see the inputs.</div></div>
        <div class="provenance">
          <strong>observed</strong> — measured from the incident record ·
          <strong>derived</strong> — computed from observed values ·
          <strong>default</strong> — city-wide median ·
          <strong>override</strong> — entered above
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ MODEL CARD ============================ -->
  <section id="tab-model" class="tab-content">
    <div class="grid">
      <div class="stats-grid">
        <div class="card span-2" style="border-left: 4px solid var(--accent);">
          <h3>Prediction engine</h3>
          <div class="value small" id="engine-status">Checking…</div>
          <div class="label" id="engine-detail"></div>
        </div>
        <div class="card span-2" style="border-left: 4px solid var(--success);">
          <h3>Hotspot classifier</h3>
          <div class="value small" id="clf-algo">—</div>
          <div class="label" id="clf-detail"></div>
        </div>
        <div class="card span-2" style="border-left: 4px solid #6f42c1;">
          <h3>Volume regressor</h3>
          <div class="value small" id="reg-algo">—</div>
          <div class="label" id="reg-detail"></div>
        </div>
        <div class="card span-2" style="border-left: 4px solid var(--warning);">
          <h3>Reported training scores</h3>
          <div class="value small" id="metrics-value">—</div>
          <div class="label" id="metrics-note"></div>
        </div>
      </div>

      <div>
        <div class="panel">
          <div class="section-header">
            <h3>What actually drives the prediction</h3>
            <p>Feature importances read from the trained estimators.</p>
          </div>
          <div class="chart-box" style="height: 380px;"><canvas id="importanceChart"></canvas></div>
        </div>

        <div class="panel">
          <div class="section-header"><h3>Limitations</h3></div>
          <ul id="limitations" style="font-size: 13.5px; color: var(--muted); padding-left: 18px;">
            <li class="skeleton">Loading…</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

</div>

<script>
(function () {
  'use strict';

  var PALETTE = {
    navy: '#0b2545', accent: '#2f6fed', danger: '#c0392b',
    warning: '#d97706', success: '#1a7f4b', muted: '#adb5bd', purple: '#6f42c1'
  };

  Chart.defaults.color = '#495057';
  Chart.defaults.font.family = "'Helvetica Neue', Helvetica, Arial, sans-serif";

  var charts = {};
  var nf = new Intl.NumberFormat('en-US');

  function fmt(n) { return (n === null || n === undefined) ? '—' : nf.format(n); }
  function el(id) { return document.getElementById(id); }

  function getJSON(url) {
    return fetch(url, { headers: { Accept: 'application/json' } }).then(function (res) {
      return res.json().then(function (body) {
        if (!res.ok) throw new Error(body.detail || body.error || ('Request failed: ' + res.status));
        return body;
      }).catch(function (err) {
        if (err instanceof SyntaxError) throw new Error('Unexpected response from the server.');
        throw err;
      });
    });
  }

  function postJSON(url, payload) {
    return fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(payload)
    }).then(function (res) {
      return res.json().then(function (body) {
        if (!res.ok) throw new Error(body.detail || body.error || ('Request failed: ' + res.status));
        return body;
      }).catch(function (err) {
        if (err instanceof SyntaxError) throw new Error('Unexpected response from the server.');
        throw err;
      });
    });
  }

  // ----------------------------------------------------------------- tabs
  var tabs = document.querySelectorAll('.tab');
  var panes = document.querySelectorAll('.tab-content');

  Array.prototype.forEach.call(tabs, function (tab) {
    tab.addEventListener('click', function () {
      Array.prototype.forEach.call(tabs, function (t) { t.classList.remove('active'); });
      Array.prototype.forEach.call(panes, function (p) { p.classList.remove('active-content'); });
      tab.classList.add('active');
      var pane = el(tab.getAttribute('data-target'));
      if (pane) pane.classList.add('active-content');
      if (tab.getAttribute('data-target') === 'tab-routing') initRoutingMap();
    });
  });

  // ------------------------------------------------------------- overview
  function loadOverview() {
    getJSON('/api/stats').then(function (s) {
      var d = s.dataset, o = s.operational, m = s.models;

      el('record-count').textContent = fmt(d.total_incidents) + ' incidents indexed';
      el('stat-incidents').textContent = fmt(d.total_incidents);
      el('stat-incidents-label').textContent =
        'Across ' + fmt(d.sectors) + ' sectors of ' + d.grid_resolution_degrees + '°';
      el('stat-hotspots').textContent = fmt(o.hotspots_flagged);
      el('stat-hotspots-label').textContent =
        Math.round(o.share_of_city_flagged * 1000) / 10 + '% of mapped sectors';
      el('stat-high').textContent = fmt(o.high_risk_sectors);
      el('stat-sectors').textContent = fmt(d.sectors);
      el('stat-grid-label').textContent = d.grid_resolution_degrees + '° grid cells';
      el('stat-busiest').textContent = fmt(d.busiest_sector_incidents);

      el('briefing').innerHTML =
        '<strong>Current assessment.</strong> The classifier flags <strong>' + fmt(o.hotspots_flagged) +
        '</strong> of ' + fmt(d.sectors) + ' mapped sectors as hotspots, <strong>' +
        fmt(o.high_risk_sectors) + '</strong> of them at high risk. Median sector on record holds ' +
        fmt(d.median_sector_incidents) + ' incidents; the busiest holds ' +
        fmt(d.busiest_sector_incidents) + '.';

      el('clf-algo').textContent = m.classifier.algorithm;
      el('clf-detail').textContent =
        m.classifier.n_estimators + ' trees, max depth ' + m.classifier.max_depth +
        ', ' + m.classifier.n_features + ' features, class weight ' + m.classifier.class_weight;
      el('reg-algo').textContent = m.regressor.algorithm;
      el('reg-detail').textContent =
        m.regressor.n_estimators + ' rounds, max depth ' + m.regressor.max_depth +
        ', objective ' + m.regressor.objective;

      var tm = m.training_metrics;
      el('metrics-value').textContent =
        tm.classifier.metric + ' ' + tm.classifier.value + ' · ' +
        tm.regressor.metric + ' ' + tm.regressor.value;
      el('metrics-note').textContent =
        'Recorded at ' + tm.measured_at + '. This service cannot recompute them — the evaluation split is not shipped with it.';
    }).catch(function (err) {
      el('briefing').className = 'notice error';
      el('briefing').textContent = 'Could not load portal statistics: ' + err.message;
      el('record-count').textContent = 'Dataset unavailable';
    });

    getJSON('/api/risk-distribution').then(function (r) {
      charts.risk = new Chart(el('riskChart'), {
        type: 'bar',
        data: {
          labels: r.histogram.map(function (h) { return h.range; }),
          datasets: [{
            label: 'Sectors',
            data: r.histogram.map(function (h) { return h.sectors; }),
            backgroundColor: r.histogram.map(function (h) {
              var low = parseFloat(h.range.split('-')[0]);
              return low >= 0.75 ? PALETTE.danger : (low >= 0.5 ? PALETTE.warning : PALETTE.accent);
            }),
            borderRadius: 3
          }]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: { callbacks: { title: function (i) { return 'Probability ' + i[0].label; } } }
          },
          scales: {
            x: { title: { display: true, text: 'Hotspot probability' }, grid: { display: false } },
            y: { title: { display: true, text: 'Sectors' }, beginAtZero: true }
          }
        }
      });

      var a = r.agreement_with_record;
      el('agreement-note').innerHTML =
        'Against the recorded incident totals, modelled hotspot probability correlates <strong>' +
        a.hotspot_probability_vs_observed + '</strong> and predicted volume correlates <strong>' +
        a.predicted_volume_vs_observed + '</strong> (Pearson, all ' +
        fmt(r.risk_bands.HIGH + r.risk_bands.MEDIUM + r.risk_bands.LOW) + ' sectors).';
    }).catch(function (err) {
      el('agreement-note').textContent = 'Risk distribution unavailable: ' + err.message;
    });

    getJSON('/api/hotspots?limit=12').then(function (h) {
      charts.top = new Chart(el('topSectorsChart'), {
        type: 'bar',
        data: {
          labels: h.hotspots.map(function (s) { return s.sector_id.replace('CHI-', ''); }),
          datasets: [
            {
              label: 'Recorded incidents',
              data: h.hotspots.map(function (s) { return s.observed_incidents; }),
              backgroundColor: PALETTE.navy, borderRadius: 3
            },
            {
              label: 'Predicted incidents',
              data: h.hotspots.map(function (s) { return s.predicted_incidents; }),
              backgroundColor: PALETTE.accent, borderRadius: 3
            }
          ]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { position: 'bottom' } },
          scales: {
            x: { grid: { display: false }, title: { display: true, text: 'Sector' } },
            y: { beginAtZero: true, title: { display: true, text: 'Incidents' } }
          }
        }
      });
    }).catch(function () { /* chart simply stays empty */ });
  }

  // ------------------------------------------------------------ model card
  function loadModelCard() {
    getJSON('/api/model-card').then(function (mc) {
      var top = mc.classifier_importances.slice(0, 10);
      var regMap = {};
      mc.regressor_importances.forEach(function (r) { regMap[r.feature] = r.importance; });

      charts.importance = new Chart(el('importanceChart'), {
        type: 'bar',
        data: {
          labels: top.map(function (f) { return f.feature; }),
          datasets: [
            { label: 'Classifier', data: top.map(function (f) { return f.importance; }),
              backgroundColor: PALETTE.success, borderRadius: 3 },
            { label: 'Regressor', data: top.map(function (f) { return regMap[f.feature] || 0; }),
              backgroundColor: PALETTE.purple, borderRadius: 3 }
          ]
        },
        options: {
          indexAxis: 'y', responsive: true, maintainAspectRatio: false,
          plugins: { legend: { position: 'bottom' } },
          scales: { x: { beginAtZero: true, title: { display: true, text: 'Importance' } },
                    y: { grid: { display: false } } }
        }
      });

      var ul = el('limitations');
      ul.innerHTML = '';
      mc.limitations.forEach(function (text) {
        var li = document.createElement('li');
        li.textContent = text;
        li.style.marginBottom = '6px';
        ul.appendChild(li);
      });
    }).catch(function (err) {
      el('limitations').innerHTML = '<li>Model card unavailable: ' + err.message + '</li>';
    });
  }

  // ---------------------------------------------------------------- health
  function loadHealth() {
    getJSON('/api/health').then(function (h) {
      var ok = h.status === 'healthy';
      var badge = el('engine-badge');
      badge.textContent = ok ? 'ENGINE ONLINE' : 'ENGINE DEGRADED';
      badge.className = 'badge' + (ok ? '' : ' offline');
      el('engine-status').textContent = ok ? 'Online' : 'Degraded';
      el('engine-detail').textContent = fmt(h.sectors_indexed) + ' sectors indexed and scored.';
    }).catch(function (err) {
      var badge = el('engine-badge');
      badge.textContent = 'ENGINE UNREACHABLE';
      badge.className = 'badge offline';
      el('engine-status').textContent = 'Unreachable';
      el('engine-detail').textContent = err.message;
    });
  }

  // -------------------------------------------------------------- assessor
  var OVERRIDE_FIELDS = [
    ['peak-input', 'peak_hour_crimes'],
    ['unique-input', 'unique_types'],
    ['lastyear-input', 'crimes_last_year'],
    ['twoyear-input', 'crimes_2yr_ago'],
    ['arrest-input', 'arrest_rate'],
    ['domestic-input', 'domestic_rate']
  ];

  function renderProvenance(result) {
    var order = Object.keys(result.features_used).sort();
    var rows = order.map(function (name) {
      var kind = result.feature_provenance[name] || 'default';
      var value = result.features_used[name];
      return '<tr><td>' + name + '</td>' +
             '<td class="num">' + (Math.abs(value) >= 1000 ? fmt(Math.round(value)) : value) + '</td>' +
             '<td><span class="tag tag-' + kind + '">' + kind + '</span></td></tr>';
    }).join('');

    el('prov-table').innerHTML =
      '<table class="prov"><thead><tr><th>Feature</th><th class="num">Value</th><th>Source</th></tr></thead>' +
      '<tbody>' + rows + '</tbody></table>';
  }

  function renderResult(r) {
    var box = el('predict-result');
    var head = el('result-head');
    var colour = r.risk_level === 'HIGH' ? PALETTE.danger
               : (r.risk_level === 'MEDIUM' ? PALETTE.warning : PALETTE.success);

    head.style.background = colour;
    el('result-verdict').textContent =
      r.risk_level + (r.is_hotspot ? ' — hotspot' : ' — not a hotspot');

    el('r-sector').textContent = r.sector_id;
    el('r-prob').textContent = (r.hotspot_probability * 100).toFixed(1) + '%';
    el('r-pred').textContent = fmt(r.predicted_incidents);
    el('r-obs').textContent = fmt(r.observed_incidents);
    el('r-conf').textContent = r.confidence === 'low' ? 'Low' : 'Normal';

    var notes = el('r-notes');
    notes.innerHTML = '';
    if (r.notes && r.notes.length) {
      r.notes.forEach(function (text) {
        var div = document.createElement('div');
        div.className = 'notice warn';
        div.style.margin = '12px 0 0';
        div.style.fontSize = '13px';
        div.textContent = text;
        notes.appendChild(div);
      });
    }

    box.style.display = 'block';
    renderProvenance(r);
  }

  el('predict-btn').addEventListener('click', function () {
    var btn = this;
    var lat = parseFloat(el('lat-input').value);
    var lon = parseFloat(el('lon-input').value);

    if (!isFinite(lat) || !isFinite(lon)) {
      el('prov-table').innerHTML = '<div class="notice error">Enter a valid latitude and longitude.</div>';
      return;
    }

    var payload = { lat: lat, lon: lon };
    OVERRIDE_FIELDS.forEach(function (pair) {
      var raw = el(pair[0]).value;
      if (raw !== '' && isFinite(parseFloat(raw))) payload[pair[1]] = parseFloat(raw);
    });

    btn.disabled = true;
    btn.textContent = 'Assessing…';

    postJSON('/api/predict', payload)
      .then(renderResult)
      .catch(function (err) {
        el('predict-result').style.display = 'none';
        el('prov-table').innerHTML = '<div class="notice error">' + err.message + '</div>';
      })
      .then(function () {
        btn.disabled = false;
        btn.textContent = 'Assess sector';
      });
  });

  // --------------------------------------------------------------- routing
  var routingMap = null;
  var routeLayer = null;

  function initRoutingMap() {
    if (routingMap) { setTimeout(function () { routingMap.invalidateSize(); }, 60); return; }
    routingMap = L.map('routingMap').setView([41.8781, -87.6298], 11);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors', maxZoom: 18
    }).addTo(routingMap);
    routeLayer = L.layerGroup().addTo(routingMap);
    setTimeout(function () { routingMap.invalidateSize(); }, 60);
  }

  el('optimize-btn').addEventListener('click', function () {
    var btn = this;
    initRoutingMap();

    var stops = Math.max(3, Math.min(20, parseInt(el('stop-count').value, 10) || 8));
    var roundTrip = el('round-trip').value === 'true';

    btn.disabled = true;
    btn.textContent = 'Solving…';
    el('route-list').innerHTML = '<div class="muted-empty">Computing the shortest sequence…</div>';
    el('route-summary').style.display = 'none';
    if (routeLayer) routeLayer.clearLayers();

    postJSON('/api/optimize-route', { from_hotspots: stops, round_trip: roundTrip })
      .then(function (data) {
        var latlngs = data.stops.map(function (s) { return [s.lat, s.lon]; });
        if (data.round_trip && latlngs.length > 1) latlngs = latlngs.concat([latlngs[0]]);

        var line = L.polyline(latlngs, { color: PALETTE.danger, weight: 4, opacity: .85 }).addTo(routeLayer);

        data.stops.forEach(function (s, i) {
          L.circleMarker([s.lat, s.lon], {
            radius: 9,
            fillColor: i === 0 ? PALETTE.success : PALETTE.navy,
            color: '#fff', weight: 2, opacity: 1, fillOpacity: 1
          }).addTo(routeLayer)
            .bindPopup('<strong>Stop ' + s.stop + '</strong><br>' + s.sector_id +
                       '<br>' + fmt(s.observed_incidents) + ' recorded incidents');
        });

        routingMap.fitBounds(line.getBounds(), { padding: [30, 30] });

        el('route-summary').style.display = 'block';
        el('route-summary').innerHTML =
          '<strong>' + data.stops.length + ' stops · ' + data.total_distance_km + ' km' +
          (data.round_trip ? ' (including a ' + data.return_leg_km + ' km return leg)' : '') +
          '</strong><br>' + data.solver + '.';

        el('route-list').innerHTML = data.stops.map(function (s, i) {
          return '<div class="route-stop' + (i === 0 ? ' start' : '') + '">' +
                   '<div class="n">' + s.stop + '</div>' +
                   '<div class="meta">' +
                     '<div class="sid">' + s.sector_id + (i === 0 ? ' · start' : '') + '</div>' +
                     '<div class="sub">' + fmt(s.observed_incidents) + ' recorded incidents</div>' +
                   '</div>' +
                   '<div class="km">' + s.cumulative_km.toFixed(1) + ' km</div>' +
                 '</div>';
        }).join('');
      })
      .catch(function (err) {
        el('route-list').innerHTML = '<div class="notice error">' + err.message + '</div>';
      })
      .then(function () {
        btn.disabled = false;
        btn.textContent = 'Generate route';
      });
  });

  // ----------------------------------------------------------------- boot
  loadHealth();
  loadOverview();
  loadModelCard();
})();
</script>

</body>
</html>
