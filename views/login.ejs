<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign in | Smart Policing Portal</title>
  <link rel="stylesheet" href="/static/css/portal.css" />
</head>
<body class="auth-body">

<div class="top-bar">SMART POLICING PORTAL</div>

<main class="auth-card">
  <section class="auth-left">
    <div class="brand">SMART POLICING<br /><span>PORTAL</span></div>
    <p class="tagline">
      Sector risk assessment and patrol planning, built on 5.7 million recorded
      Chicago incidents.
    </p>
    <ul class="facts">
      <li>Hotspot classification across 2,550 city sectors</li>
      <li>Incident-volume forecasting per sector</li>
      <li>Shortest-path patrol routing</li>
    </ul>
  </section>

  <section class="auth-right">
    <h1>Sign in</h1>
    <p class="subtitle">Enter your credentials to open the portal.</p>

    <% if (typeof error !== 'undefined' && error && error.length) { %>
      <div class="alert alert-error" role="alert"><%= Array.isArray(error) ? error[0] : error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success && success.length) { %>
      <div class="alert alert-success" role="status"><%= Array.isArray(success) ? success[0] : success %></div>
    <% } %>

    <form action="/login" method="POST" autocomplete="on">
      <div class="form-group">
        <label for="email">Email</label>
        <input id="email" type="email" name="email" required autocomplete="username" />
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input id="password" type="password" name="password" required autocomplete="current-password" />
      </div>

      <button class="btn" type="submit">Sign in</button>
    </form>

    <% if (googleEnabled) { %>
      <div class="divider">or</div>
      <a href="/auth/google" style="text-decoration: none;">
        <button class="btn btn-secondary" type="button">Continue with Google</button>
      </a>
    <% } %>

    <p class="links">Don't have an account? <a href="/signup">Create one</a></p>
  </section>
</main>

</body>
</html>
