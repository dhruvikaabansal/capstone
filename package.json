{
  "name": "smart-policing-portal",
  "version": "2.0.0",
  "description": "Sector risk assessment and patrol planning portal, built on Chicago incident data with a Python prediction service.",
  "main": "app.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "policing",
    "crime-analytics",
    "hotspot-prediction",
    "express",
    "fastapi",
    "machine-learning"
  ],
  "author": "dhruvikaabansal",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "dotenv": "^17.3.1",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "express-flash": "^0.0.2",
    "express-session": "^1.19.0",
    "mongoose": "^9.9.4",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0"
  }
}
